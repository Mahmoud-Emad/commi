{
  "name": "commi-website",
  "version": "1.0.0",
  "description": "Official website for Commi - AI-powered Git commit message generator",
  "main": "index.html",
  "scripts": {
    "dev": "python -m http.server 8000",
    "dev:node": "npx serve . -p 8000",
    "build": "node scripts/build.js",
    "build:css": "node scripts/build-css.js",
    "build:js": "node scripts/build-js.js",
    "build:html": "node scripts/build-html.js",
    "optimize": "node scripts/optimize.js",
    "validate": "node scripts/validate.js",
    "lighthouse": "lighthouse http://localhost:8000 --output=html --output-path=./reports/lighthouse.html",
    "test": "node scripts/test.js",
    "clean": "node scripts/clean.js"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "gemini",
    "cli",
    "rust",
    "developer-tools"
  ],
  "author": "Mahmoud Emad",
  "license": "MIT",
  "devDependencies": {
    "clean-css": "^5.3.2",
    "html-minifier": "^4.0.0",
    "terser": "^5.19.4",
    "imagemin": "^8.0.1",
    "imagemin-pngquant": "^9.0.2",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-svgo": "^10.0.1",
    "lighthouse": "^11.0.0",
    "serve": "^14.2.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Mahmoud-Emad/commi.git"
  },
  "homepage": "https://commi.sh"
}
